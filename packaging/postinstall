#!/bin/sh
set -eu

console_user="$(/usr/bin/stat -f %Su /dev/console)"
if [ "$console_user" = "root" ] || [ "$console_user" = "loginwindow" ]; then
  exit 0
fi

console_uid="$(/usr/bin/id -u "$console_user")"
setup_app="/Library/Application Support/Geer/app/Geer Setup.app"
setup_command="/Library/Application Support/Geer/app/geer-setup.command"

if [ -d "$setup_app" ]; then
  if /bin/launchctl asuser "$console_uid" \
    /usr/bin/sudo -u "$console_user" \
    /usr/bin/open "$setup_app" >/dev/null 2>&1; then
    exit 0
  fi
fi

/bin/launchctl asuser "$console_uid" \
  /usr/bin/sudo -u "$console_user" \
  /usr/bin/open "$setup_command" >/dev/null 2>&1 &

exit 0

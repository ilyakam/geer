root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{bash,sh,zsh}]
indent_size = 2

[*.{json,yaml,yml}]
indent_size = 2

[*.{md,markdown,mdx}]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
